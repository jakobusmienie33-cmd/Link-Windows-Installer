<Application x:Class="Link.Windows.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"\n             xmlns:coreModels="clr-namespace:Link.Windows.Installer.Core.Models;assembly=Link.Windows.Installer.Core"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="GreenBrush" Color="#74EB49"/>
        <SolidColorBrush x:Key="Green2Brush" Color="#3FCA40"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#71808A"/>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#26343D"/>
            <Setter Property="BorderBrush" Value="#C6D2D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F5F8F9"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#3FCA40"/>
            <Setter Property="BorderBrush" Value="#44BD40"/>
            <Setter Property="Foreground" Value="#122514"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5DFE4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>

        <Style x:Key="StatusPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#EAF2FB"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static coreModels:SystemCheckState.Pass}"><Setter Property="Background" Value="#E8F8E5"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static coreModels:SystemCheckState.Warning}"><Setter Property="Background" Value="#FFF5DE"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static coreModels:SystemCheckState.Block}"><Setter Property="Background" Value="#FFEDED"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="8,7">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#223A45"/></Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
