<Window x:Class="Link.Windows.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Link — Windows Setup"
        Width="1280"
        Height="840"
        MinWidth="1024"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#DFE7EC"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#101B24">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="34" FontWeight="Bold" Foreground="White">
                    <Run Text="The "/><Run Text="Link" Foreground="{StaticResource GreenBrush}"/>
                </TextBlock>
                <Border Grid.Column="1" Width="1" Height="34" Margin="20,0" Background="#52616A" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Windows Setup" VerticalAlignment="Center" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="● Installer Ready" Foreground="#72E967" FontSize="12" Margin="0,0,16,0"/>
                    <TextBlock Text="Windows 10 / 11 • x64 / ARM64 packaging profiles" Foreground="#C6D1D7" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Border Background="White" BorderBrush="#CBD7DD" BorderThickness="1" CornerRadius="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="312"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#172B35" CornerRadius="18,0,0,18">
                        <Grid Margin="18,22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Width="62" Height="62" HorizontalAlignment="Left"
                                    Background="{StaticResource Green2Brush}" CornerRadius="16">
                                <TextBlock Text="L" FontSize="32" FontWeight="Bold" Foreground="#153019"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,12,0,12">
                                <TextBlock Text="The Link" Foreground="White" FontSize="23" FontWeight="Bold"/>
                                <TextBlock Text="Comprehensive Windows Installation &amp; Configuration Wizard"
                                           Foreground="#B8C6CC" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding Steps}"
                                     SelectedIndex="{Binding CurrentStepIndex, Mode=OneWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource StepItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" CornerRadius="13" Background="#28414C" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Number}" Foreground="#C8D6DC" FontSize="10" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#D8E6EB"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="{StaticResource GreenBrush}"
                                                       VerticalAlignment="Center" FontSize="9"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="3">
                                <Border Height="1" Background="#40545D" Margin="0,8,0,10"/>
                                <TextBlock Text="By MeetWell Technologies" FontWeight="SemiBold" Foreground="#D2DEE3" FontSize="10"/>
                                <TextBlock Text="Signed packages • least privilege • auditable setup" Foreground="#8EA0A8" FontSize="9" Margin="0,3,0,0"/>
                                <TextBlock Text="Installer source • v0.7.0-dev" Foreground="#8EA0A8" FontSize="9"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Background="#F8FAFB">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="72"/>
                        </Grid.RowDefinitions>

                        <TabControl Grid.Row="0"
                                    SelectedIndex="{Binding CurrentStepIndex, Mode=OneWay}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Margin="28,24,28,16">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Style>
                            </TabControl.Resources>

                            <!-- Step 1: Welcome -->
                            <TabItem>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Welcome to The Link Setup" FontSize="27" FontWeight="Bold" Foreground="#15212A"/>
                                                <TextBlock Text="This wizard installs The Link for Windows, prepares the appropriate local data layer, configures optional hardware services and leaves organisation access to the normal Link sign-in process."
                                                           FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,20,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#EAF8E7" CornerRadius="12" Padding="9,5" VerticalAlignment="Top">
                                                <TextBlock Text="Step 1 of 12" Foreground="#34852E" FontWeight="SemiBold" FontSize="10"/>
                                            </Border>
                                        </Grid>

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="What Setup Can Configure" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <UniformGrid Columns="2">
                                                    <Border BorderBrush="#D9E2E6" BorderThickness="1" CornerRadius="9" Padding="11" Margin="4">
                                                        <StackPanel>
                                                            <TextBlock Text="✓  The Link Windows application" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Main desktop app, shared shell, shortcuts and uninstall metadata." Foreground="#82909A" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border BorderBrush="#D9E2E6" BorderThickness="1" CornerRadius="9" Padding="11" Margin="4">
                                                        <StackPanel>
                                                            <TextBlock Text="✓  Local SQLite data layer" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Recommended workstation cache/offline layer; no separate database server required." Foreground="#82909A" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border BorderBrush="#D9E2E6" BorderThickness="1" CornerRadius="9" Padding="11" Margin="4">
                                                        <StackPanel>
                                                            <TextBlock Text="DB  Optional PostgreSQL branch/server mode" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Advanced deployment only: detect existing PostgreSQL or prepare an approved local package." Foreground="#82909A" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border BorderBrush="#D9E2E6" BorderThickness="1" CornerRadius="9" Padding="11" Margin="4">
                                                        <StackPanel>
                                                            <TextBlock Text="▦  Device and background services" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Prepared later for approved printers, scanners, scales, sync and update services." Foreground="#82909A" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#EDF5FC" BorderBrush="#C8DBED" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,8,0,0">
                                            <TextBlock TextWrapping="Wrap" Foreground="#3F668D" FontSize="11">
                                                <Run Text="Production cloud database rule: " FontWeight="Bold"/>
                                                <Run Text="normal Windows clients use the configured Link backend through the application. This installer does not run production cloud DDL or store a Supabase service_role secret."/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Step 2: System Check -->
                            <TabItem>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="System Compatibility Check" FontSize="27" FontWeight="Bold"/>
                                                <TextBlock Text="Setup validates Windows, architecture, disk, permissions, networking and existing database/runtime components before writing files."
                                                           FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,20,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#EAF8E7" CornerRadius="12" Padding="9,5" VerticalAlignment="Top">
                                                <TextBlock Text="Step 2 of 12" Foreground="#34852E" FontWeight="SemiBold" FontSize="10"/>
                                            </Border>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding SystemChecks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#D9E2E6" BorderThickness="1" CornerRadius="9" Padding="9" Margin="0,3" Background="White">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <Border Width="28" Height="28" CornerRadius="14" Background="#EDF2F4" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Icon}" FontSize="9" FontWeight="Bold" Foreground="#5D6D77" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"/>
                                                                <TextBlock Text="{Binding Detail}" Foreground="#82909A" FontSize="10" TextWrapping="Wrap" Margin="0,2,12,0"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Badge}" FontWeight="Bold" FontSize="9"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Background="#EEF8EB" BorderBrush="#C9E8C0" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,10,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SystemCheckSummary}" TextWrapping="Wrap" FontSize="11"/>
                                                <Button Grid.Column="1" Content="Run checks again" Margin="12,0,0,0" Style="{StaticResource BaseButtonStyle}" Click="RefreshSystemChecks_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Step 3: Install Type -->
                            <TabItem>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Choose Installation Type" FontSize="27" FontWeight="Bold"/>
                                                <TextBlock Text="The workstation profile changes local components and service defaults. It does not grant application privileges."
                                                           FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,20,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#EAF8E7" CornerRadius="12" Padding="9,5" VerticalAlignment="Top">
                                                <TextBlock Text="Step 3 of 12" Foreground="#34852E" FontWeight="SemiBold" FontSize="10"/>
                                            </Border>
                                        </Grid>

                                        <UniformGrid Columns="2" Margin="-5">
                                            <Border Style="{StaticResource CardStyle}" Margin="5">
                                                <RadioButton GroupName="InstallProfile" Tag="Standard Workstation" IsChecked="True" Checked="Profile_Checked">
                                                    <StackPanel Margin="6"><TextBlock Text="Standard Workstation" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Recommended office/admin profile. Cloud backend + local SQLite cache." Foreground="#7B8992" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                                                </RadioButton>
                                            </Border>
                                            <Border Style="{StaticResource CardStyle}" Margin="5">
                                                <RadioButton GroupName="InstallProfile" Tag="POS / Sharing Point" Checked="Profile_Checked">
                                                    <StackPanel Margin="6"><TextBlock Text="POS / Sharing Point" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Prepares device-bridge defaults for POS peripherals and payment integration." Foreground="#7B8992" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                                                </RadioButton>
                                            </Border>
                                            <Border Style="{StaticResource CardStyle}" Margin="5">
                                                <RadioButton GroupName="InstallProfile" Tag="Back-Office / Admin" Checked="Profile_Checked">
                                                    <StackPanel Margin="6"><TextBlock Text="Back-Office / Admin" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Finance, stock, HR and reporting with minimal device services." Foreground="#7B8992" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                                                </RadioButton>
                                            </Border>
                                            <Border Style="{StaticResource CardStyle}" Margin="5">
                                                <RadioButton GroupName="InstallProfile" Tag="Branch Server / Advanced" Checked="Profile_Checked">
                                                    <StackPanel Margin="6"><TextBlock Text="Branch Server / Advanced" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Advanced profile that can use an approved local PostgreSQL database/service." Foreground="#7B8992" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                                                </RadioButton>
                                            </Border>
                                        </UniformGrid>

                                        <Border Background="#EDF5FC" BorderBrush="#C8DBED" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,10,0,0">
                                            <TextBlock FontSize="11"><Run Text="Selected profile: " FontWeight="Bold"/><Run Text="{Binding SelectedInstallProfile}"/></TextBlock>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Step 4: Components / prerequisites -->
                            <TabItem>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Select Components" FontSize="27" FontWeight="Bold"/>
                                                <TextBlock Text="Select local Windows components and review prerequisite availability. Business modules remain permission-driven inside one Link application."
                                                           FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,20,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#EAF8E7" CornerRadius="12" Padding="9,5" VerticalAlignment="Top">
                                                <TextBlock Text="Step 4 of 12" Foreground="#34852E" FontWeight="SemiBold" FontSize="10"/>
                                            </Border>
                                        </Grid>

                                        <UniformGrid Columns="2" Margin="-5">
                                            <Border Style="{StaticResource CardStyle}" Margin="5"><CheckBox IsChecked="True"><StackPanel Margin="5"><TextBlock Text="The Link Windows App" FontWeight="SemiBold"/><TextBlock Text="Main application, shared shell, authentication and module launcher." Foreground="#7B8992" FontSize="10" TextWrapping="Wrap"/></StackPanel></CheckBox></Border>
                                            <Border Style="{StaticResource CardStyle}" Margin="5"><CheckBox IsChecked="True"><StackPanel Margin="5"><TextBlock Text="Encrypted / Local SQLite Cache" FontWeight="SemiBold"/><TextBlock Text="Approved offline/cache data and durable sync queue." Foreground="#7B8992" FontSize="10" TextWrapping="Wrap"/></StackPanel></CheckBox></Border>
                                            <Border Style="{StaticResource CardStyle}" Margin="5"><CheckBox IsChecked="True"><StackPanel Margin="5"><TextBlock Text="Device Bridge" FontWeight="SemiBold"/><TextBlock Text="Prepared for approved local printers, scanners, scales and adapters." Foreground="#7B8992" FontSize="10" TextWrapping="Wrap"/></StackPanel></CheckBox></Border>
                                            <Border Style="{StaticResource CardStyle}" Margin="5"><CheckBox IsChecked="True"><StackPanel Margin="5"><TextBlock Text="Automatic Updater" FontWeight="SemiBold"/><TextBlock Text="Signed application update service; implementation continues in later phases." Foreground="#7B8992" FontSize="10" TextWrapping="Wrap"/></StackPanel></CheckBox></Border>
                                            <Border Style="{StaticResource CardStyle}" Margin="5"><CheckBox><StackPanel Margin="5"><TextBlock Text="Background Diagnostics" FontWeight="SemiBold"/><TextBlock Text="Optional user-authorised LinkHelp diagnostic service." Foreground="#7B8992" FontSize="10" TextWrapping="Wrap"/></StackPanel></CheckBox></Border>
                                            <Border Style="{StaticResource CardStyle}" Margin="5"><CheckBox><StackPanel Margin="5"><TextBlock Text="Branch PostgreSQL Service" FontWeight="SemiBold"/><TextBlock Text="Advanced branch-server component only; database mode controls actual setup." Foreground="#7B8992" FontSize="10" TextWrapping="Wrap"/></StackPanel></CheckBox></Border>
                                        </UniformGrid>

                                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Prerequisite Manager" FontSize="15" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding PrerequisiteSummary}" Foreground="#82909A" FontSize="10" TextWrapping="Wrap" Margin="0,3,16,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Rescan" Style="{StaticResource BaseButtonStyle}" Click="RefreshPrerequisites_Click"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Prerequisites}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#E0E7EA" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,3">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"/>
                                                                        <TextBlock Text="{Binding Detail}" Foreground="#82909A" FontSize="9.5" TextWrapping="Wrap" Margin="0,2,10,0"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Text="{Binding State}" FontWeight="SemiBold" Foreground="#3D6C9F" FontSize="10"/>
                                                                        <TextBlock Text="{Binding Version}" Foreground="#82909A" FontSize="9"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Action}" Foreground="#5D6D77" FontSize="9.5" TextWrapping="Wrap"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#EDF5FC" BorderBrush="#C8DBED" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,10,0,0">
                                            <TextBlock Text="Prerequisites are detected first and are never silently downloaded. Missing required runtimes are supplied later only from the signed installer payload or an approved organisation-managed source." TextWrapping="Wrap" Foreground="#3F668D" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Step 5: Database / SQL -->
                            <TabItem>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Database / SQL Setup" FontSize="27" FontWeight="Bold"/>
                                                <TextBlock Text="Choose how this Windows installation stores local data and connects to the authoritative Link backend."
                                                           FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,20,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#EAF8E7" CornerRadius="12" Padding="9,5" VerticalAlignment="Top">
                                                <TextBlock Text="Step 5 of 12" Foreground="#34852E" FontWeight="SemiBold" FontSize="10"/>
                                            </Border>
                                        </Grid>

                                        <UniformGrid Columns="2" Margin="-5">
                                            <Border Style="{StaticResource CardStyle}" Margin="5"><RadioButton GroupName="DbMode" Tag="cloud" IsChecked="True" Checked="DatabaseMode_Checked"><StackPanel Margin="5"><TextBlock Text="Cloud Supabase + Local SQLite" FontWeight="SemiBold"/><TextBlock Text="Recommended normal workstation mode." Foreground="#7B8992" FontSize="10"/></StackPanel></RadioButton></Border>
                                            <Border Style="{StaticResource CardStyle}" Margin="5"><RadioButton GroupName="DbMode" Tag="existingpg" Checked="DatabaseMode_Checked"><StackPanel Margin="5"><TextBlock Text="Connect to Existing PostgreSQL" FontWeight="SemiBold"/><TextBlock Text="Advanced approved branch/server deployment." Foreground="#7B8992" FontSize="10"/></StackPanel></RadioButton></Border>
                                            <Border Style="{StaticResource CardStyle}" Margin="5"><RadioButton GroupName="DbMode" Tag="installpg" Checked="DatabaseMode_Checked"><StackPanel Margin="5"><TextBlock Text="Install Local PostgreSQL" FontWeight="SemiBold"/><TextBlock Text="Advanced; signed approved package only." Foreground="#7B8992" FontSize="10"/></StackPanel></RadioButton></Border>
                                            <Border Style="{StaticResource CardStyle}" Margin="5"><RadioButton GroupName="DbMode" Tag="sqliteonly" Checked="DatabaseMode_Checked"><StackPanel Margin="5"><TextBlock Text="Local SQLite Only / Offline Preparation" FontWeight="SemiBold"/><TextBlock Text="Remote activation intentionally deferred." Foreground="#7B8992" FontSize="10"/></StackPanel></RadioButton></Border>
                                        </UniformGrid>

                                        <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Cloud / Backend Configuration" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="Backend URL" FontSize="9" FontWeight="SemiBold" Foreground="#677781" Margin="0,9,0,4"/>
                                                <TextBox Text="{Binding BackendUrl, UpdateSourceTrigger=PropertyChanged}" Padding="9" BorderBrush="#CBD7DD" ToolTip="Use the organisation-approved Link/Supabase backend URL. No service_role secret is stored here."/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="PostgreSQL Discovery &amp; Connection" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding PostgreSqlSummary}" FontSize="10" Foreground="#82909A" TextWrapping="Wrap" Margin="0,3,16,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Discover PostgreSQL" Style="{StaticResource BaseButtonStyle}" Click="DiscoverPostgreSql_Click"/>
                                                </Grid>

                                                <TextBlock Text="Detected local instance" FontSize="9" FontWeight="SemiBold" Foreground="#677781" Margin="0,10,0,4"/>
                                                <ComboBox ItemsSource="{Binding PostgreSqlInstances}" SelectedItem="{Binding SelectedPostgreSql}" DisplayMemberPath="DisplayName" Padding="6"/>

                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Host" FontSize="9" FontWeight="SemiBold" Foreground="#677781" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding DatabaseHost, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Port" FontSize="9" FontWeight="SemiBold" Foreground="#677781" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding DatabasePort, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Database" FontSize="9" FontWeight="SemiBold" Foreground="#677781" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Restricted runtime user" FontSize="9" FontWeight="SemiBold" Foreground="#677781" Margin="0,0,0,4"/>
                                                        <TextBox Text="{Binding DatabaseUser, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Password (used only for validation, then protected by Windows Credential Manager)" FontSize="9" FontWeight="SemiBold" Foreground="#677781" Margin="0,10,0,4"/>
                                                <PasswordBox x:Name="PostgresPasswordBox" Padding="8"/>

                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DatabaseValidationSummary}" FontSize="10" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding CredentialReference}" FontSize="9" Foreground="#82909A" TextWrapping="Wrap" Margin="0,3,12,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Validate connection" Style="{StaticResource PrimaryButtonStyle}" Click="ValidateDatabase_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DatabasePlanTitle}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DatabasePlanSummary}" FontSize="10" Foreground="#82909A" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                                <ItemsControl ItemsSource="{Binding DatabasePlanSteps}">
                                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" FontSize="10" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#FFF7E6" BorderBrush="#ECD18E" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Security / bootstrap contract" FontWeight="SemiBold" Foreground="#73561C"/>
                                                <ItemsControl ItemsSource="{Binding DatabaseSecurityControls}">
                                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Foreground="#73561C" FontSize="9.5" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Step 6: Install Location -->
                            <TabItem>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Installation Location" FontSize="27" FontWeight="Bold"/>
                                                <TextBlock Text="Choose application and local-data locations. Setup validates absolute paths, free space, data separation, existing folders and elevation requirements."
                                                           FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,20,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#EAF8E7" CornerRadius="12" Padding="9,5" VerticalAlignment="Top">
                                                <TextBlock Text="Step 6 of 12" Foreground="#34852E" FontWeight="SemiBold" FontSize="10"/>
                                            </Border>
                                        </Grid>

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding InstallForAllUsers}" Content="Install for all users on this computer (per-machine)" Margin="0,0,0,10"/>
                                                <TextBlock Text="Application folder" FontSize="9" FontWeight="SemiBold" Foreground="#677781" Margin="0,5,0,4"/>
                                                <TextBox Text="{Binding ApplicationDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                                                <TextBlock Text="Local data folder" FontSize="9" FontWeight="SemiBold" Foreground="#677781" Margin="0,9,0,4"/>
                                                <TextBox Text="{Binding DataDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                                                <TextBlock Text="Local SQLite / cache folder" FontSize="9" FontWeight="SemiBold" Foreground="#677781" Margin="0,9,0,4"/>
                                                <TextBox Text="{Binding CacheDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                                                <TextBlock Text="Installer logs" FontSize="9" FontWeight="SemiBold" Foreground="#677781" Margin="0,9,0,4"/>
                                                <TextBox Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                                                <TextBlock Text="Backup / migration checkpoints" FontSize="9" FontWeight="SemiBold" Foreground="#677781" Margin="0,9,0,4"/>
                                                <TextBox Text="{Binding BackupDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                                                <TextBlock Text="Start Menu folder" FontSize="9" FontWeight="SemiBold" Foreground="#677781" Margin="0,9,0,4"/>
                                                <TextBox Text="{Binding StartMenuFolder, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>

                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding PathValidationSummary}" TextWrapping="Wrap" FontSize="10" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="Validate locations" Style="{StaticResource PrimaryButtonStyle}" Click="ValidatePaths_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding PathMessages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#EDF5FC" BorderBrush="#C8DBED" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,3">
                                                        <TextBlock Text="{Binding}" FontSize="9.5" TextWrapping="Wrap"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Background="#EDF5FC" BorderBrush="#C8DBED" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,8,0,0">
                                            <TextBlock Text="Mutable data, logs and backups are kept outside Program Files. Existing compatible directories are preserved. Actual directory creation and ACL application occur only when installation begins." TextWrapping="Wrap" Foreground="#3F668D" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem><TextBlock Text="Device &amp; Services — LWI-P8+ implementation boundary" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" Foreground="{StaticResource MutedBrush}"/></TabItem>
                            <TabItem><TextBlock Text="Network &amp; Security — planned" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="{StaticResource MutedBrush}"/></TabItem>
                            <TabItem><TextBlock Text="Updates &amp; Privacy — planned" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="{StaticResource MutedBrush}"/></TabItem>
                            <TabItem><TextBlock Text="Review — planned" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="{StaticResource MutedBrush}"/></TabItem>
                            <TabItem><TextBlock Text="Installing — planned" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="{StaticResource MutedBrush}"/></TabItem>
                            <TabItem><TextBlock Text="Complete — planned" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="{StaticResource MutedBrush}"/></TabItem>
                        </TabControl>

                        <Border Grid.Row="1" BorderBrush="#D7E0E4" BorderThickness="0,1,0,0" Background="White">
                            <Grid Margin="22,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FooterStatus}" Foreground="#7B8992" FontSize="11"/>
                                    <TextBlock Text="{Binding LogPath, StringFormat=Setup log: {0}}" Foreground="#A0ADB4" FontSize="9" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Cancel" Style="{StaticResource BaseButtonStyle}" Click="Cancel_Click" Margin="0,0,8,0"/>
                                    <Button Content="Back" Style="{StaticResource BaseButtonStyle}" Click="Back_Click" IsEnabled="{Binding CanBack}" Margin="0,0,8,0"/>
                                    <Button Content="Next" Style="{StaticResource PrimaryButtonStyle}" Click="Next_Click" IsEnabled="{Binding CanNext}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
